[Unit]
Description=Deploy website main and publish Rakuen blog updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/rakuen-web
ExecStart=/opt/rakuen-web/scripts/autopublish.sh
# deploy.sh serializes code and article publishers, validates before switching,
# and restores the previous deployment on failure. The next tick retries.
TimeoutStartSec=600
